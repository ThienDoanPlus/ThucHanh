# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Flagship Store Coordinates (294 Pham Van Bach, Tan Son Ward, Tan Binh, HCMC)
ORIGIN_LAT="10.8231"
ORIGIN_LNG="106.6458"

# VietQR & Custom QR Code Settings
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0901234567"
VIETQR_ACCOUNT_NAME="LUMINA OPTICS STORE"
CUSTOM_QR_IMAGE_URL=""

# Cloudinary (Optional for signed prescription/product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# TiDB Cloud Connection (Used by Django Rest Framework reference backend)
TIDB_DATABASE_URL="mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/eyewear_db"

# Gmail SMTP for Order Confirmation Emails (Optional)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

